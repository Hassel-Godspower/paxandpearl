    <style>

        /* =====================================================
           OFFICE WORKER WELLNESS
        ====================================================== */

        :root {
            --ow-green: #173c32;
            --ow-green-dark: #102c25;
            --ow-green-soft: #eaf1ed;
            --ow-gold: #b99655;
            --ow-gold-soft: #f4ecdd;
            --ow-cream: #f7f4ed;
            --ow-white: #ffffff;
            --ow-text: #26312d;
            --ow-muted: #66736d;
            --ow-border: #dfe5e1;
            --ow-shadow: 0 18px 45px rgba(16, 44, 37, 0.08);
            --ow-radius: 18px;
        }


        .ow-page {
            background: var(--ow-white);
            color: var(--ow-text);
            font-family: "DM Sans", sans-serif;
            line-height: 1.75;
        }


        .ow-page *,
        .ow-page *::before,
        .ow-page *::after {
            box-sizing: border-box;
        }


        .ow-page a {
            color: inherit;
        }


        .ow-container {
            width: min(1180px, calc(100% - 40px));
            margin: 0 auto;
        }


        /* =====================================================
           BREADCRUMB
        ====================================================== */

        .ow-breadcrumb {
            padding: 18px 0;
            background: var(--ow-cream);
            border-bottom: 1px solid var(--ow-border);
        }


        .ow-breadcrumb ol {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin: 0;
            padding: 0;
            list-style: none;
            color: var(--ow-muted);
            font-size: 0.82rem;
        }


        .ow-breadcrumb li {
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }


        .ow-breadcrumb li:not(:last-child)::after {
            content: "/";
            color: #9ba59f;
        }


        .ow-breadcrumb a {
            text-decoration: none;
        }


        .ow-breadcrumb a:hover {
            color: var(--ow-green);
        }


        /* =====================================================
           HERO
        ====================================================== */

        .ow-hero {
            position: relative;
            overflow: hidden;
            padding: 84px 0 82px;
            color: var(--ow-white);
            background:
                radial-gradient(
                    circle at 85% 18%,
                    rgba(185,150,85,0.19),
                    transparent 28%
                ),
                linear-gradient(
                    135deg,
                    var(--ow-green-dark),
                    var(--ow-green)
                );
        }


        .ow-hero::before {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            right: -240px;
            top: -260px;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 50%;
        }


        .ow-hero-inner {
            position: relative;
            z-index: 2;
            display: grid;
            grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
            gap: 60px;
            align-items: center;
        }


        .ow-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 18px;
            color: #dbc38f;
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }


        .ow-eyebrow::before {
            content: "";
            width: 28px;
            height: 1px;
            background: var(--ow-gold);
        }


        .ow-hero h1 {
            max-width: 850px;
            margin: 0 0 22px;
            font-family: "Manrope", sans-serif;
            font-size: clamp(2.35rem, 5vw, 4.5rem);
            line-height: 1.05;
            letter-spacing: -0.045em;
        }


        .ow-hero h1 span {
            color: #d8bd80;
        }


        .ow-hero-intro {
            max-width: 790px;
            margin: 0;
            color: rgba(255,255,255,0.82);
            font-size: clamp(1rem, 1.6vw, 1.18rem);
        }


        .ow-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 32px;
        }


        .ow-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            min-height: 50px;
            padding: 13px 21px;
            border-radius: 999px;
            text-decoration: none;
            font-weight: 800;
            transition:
                transform 0.2s ease,
                background 0.2s ease;
        }


        .ow-button:hover {
            transform: translateY(-2px);
        }


        .ow-button-primary {
            background: var(--ow-gold);
            color: #17231f;
        }


        .ow-button-secondary {
            border: 1px solid rgba(255,255,255,0.25);
            background: rgba(255,255,255,0.06);
            color: var(--ow-white);
        }


        .ow-hero-card {
            padding: 28px;
            border: 1px solid rgba(255,255,255,0.13);
            border-radius: 22px;
            background: rgba(255,255,255,0.07);
            backdrop-filter: blur(10px);
        }


        .ow-hero-card-label {
            margin-bottom: 16px;
            color: #dbc38f;
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }


        .ow-hero-card strong {
            display: block;
            margin-bottom: 12px;
            font-family: "Manrope", sans-serif;
            font-size: 1.4rem;
            line-height: 1.25;
        }


        .ow-hero-card p {
            margin: 0;
            color: rgba(255,255,255,0.73);
            font-size: 0.95rem;
        }


        /* =====================================================
           QUICK ANSWER
        ====================================================== */

        .ow-answer {
            position: relative;
            z-index: 5;
            margin-top: -35px;
        }


        .ow-answer-card {
            display: grid;
            grid-template-columns: 75px minmax(0,1fr);
            gap: 24px;
            padding: 30px;
            border: 1px solid var(--ow-border);
            border-radius: var(--ow-radius);
            background: var(--ow-white);
            box-shadow: var(--ow-shadow);
        }


        .ow-answer-icon {
            width: 58px;
            height: 58px;
            display: grid;
            place-items: center;
            border-radius: 16px;
            background: var(--ow-green-soft);
            color: var(--ow-green);
        }


        .ow-answer-icon .material-icons-round {
            font-size: 28px;
        }


        .ow-answer-card h2 {
            margin: 0 0 8px;
            font-family: "Manrope", sans-serif;
            font-size: 1.35rem;
            line-height: 1.25;
        }


        .ow-answer-card p {
            margin: 0;
            color: var(--ow-muted);
        }


        /* =====================================================
           SECTIONS
        ====================================================== */

        .ow-section {
            padding: 82px 0;
        }


        .ow-section.soft {
            background: var(--ow-cream);
        }


        .ow-section.green {
            background: var(--ow-green);
            color: var(--ow-white);
        }


        .ow-heading {
            max-width: 800px;
            margin-bottom: 42px;
        }


        .ow-heading.center {
            margin-left: auto;
            margin-right: auto;
            text-align: center;
        }


        .ow-heading .eyebrow {
            display: block;
            margin-bottom: 10px;
            color: var(--ow-gold);
            font-size: 0.76rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }


        .ow-heading h2 {
            margin: 0 0 16px;
            color: var(--ow-green-dark);
            font-family: "Manrope", sans-serif;
            font-size: clamp(1.9rem, 3.5vw, 3rem);
            line-height: 1.1;
            letter-spacing: -0.035em;
        }


        .ow-section.green .ow-heading h2 {
            color: var(--ow-white);
        }


        .ow-heading p {
            margin: 0;
            color: var(--ow-muted);
            font-size: 1.04rem;
        }


        .ow-section.green .ow-heading p {
            color: rgba(255,255,255,0.72);
        }


        .ow-prose {
            max-width: 870px;
        }


        .ow-prose p {
            margin: 0 0 20px;
        }


        .ow-prose p:last-child {
            margin-bottom: 0;
        }


        .ow-prose strong {
            color: var(--ow-green-dark);
        }


        /* =====================================================
           CARDS
        ====================================================== */

        .ow-grid {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 20px;
        }


        .ow-grid.two {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }


        .ow-card {
            height: 100%;
            padding: 28px;
            border: 1px solid var(--ow-border);
            border-radius: var(--ow-radius);
            background: var(--ow-white);
        }


        .ow-card.shadow {
            box-shadow: var(--ow-shadow);
        }


        .ow-card-icon {
            width: 48px;
            height: 48px;
            display: grid;
            place-items: center;
            margin-bottom: 19px;
            border-radius: 14px;
            background: var(--ow-green-soft);
            color: var(--ow-green);
        }


        .ow-card h3 {
            margin: 0 0 10px;
            color: var(--ow-green-dark);
            font-family: "Manrope", sans-serif;
            font-size: 1.15rem;
            line-height: 1.25;
        }


        .ow-card p {
            margin: 0;
            color: var(--ow-muted);
        }


        /* =====================================================
           DAILY ROUTINE
        ====================================================== */

        .ow-routine {
            display: grid;
            grid-template-columns: repeat(4,minmax(0,1fr));
            gap: 16px;
        }


        .ow-routine-item {
            padding: 25px 21px;
            border: 1px solid var(--ow-border);
            border-radius: var(--ow-radius);
            background: var(--ow-white);
        }


        .ow-time {
            margin-bottom: 14px;
            color: var(--ow-gold);
            font-family: "Manrope", sans-serif;
            font-size: 0.76rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }


        .ow-routine-item h3 {
            margin: 0 0 8px;
            color: var(--ow-green-dark);
            font-family: "Manrope", sans-serif;
            font-size: 1rem;
        }


        .ow-routine-item p {
            margin: 0;
            color: var(--ow-muted);
            font-size: 0.91rem;
        }


        /* =====================================================
           CHECKLIST
        ====================================================== */

        .ow-list {
            display: grid;
            gap: 14px;
            margin: 0;
            padding: 0;
            list-style: none;
        }


        .ow-list li {
            display: grid;
            grid-template-columns: 28px 1fr;
            gap: 12px;
            align-items: start;
        }


        .ow-check {
            width: 25px;
            height: 25px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: var(--ow-green-soft);
            color: var(--ow-green);
        }


        .ow-check .material-icons-round {
            font-size: 16px;
        }


        .ow-list strong {
            color: var(--ow-green-dark);
        }


        /* =====================================================
           TWO COLUMN FEATURE
        ====================================================== */

        .ow-feature {
            display: grid;
            grid-template-columns: 0.85fr 1.15fr;
            gap: 55px;
            align-items: center;
        }


        .ow-feature-box {
            padding: 35px;
            border-radius: 24px;
            background:
                linear-gradient(
                    145deg,
                    var(--ow-green),
                    var(--ow-green-dark)
                );
            color: var(--ow-white);
        }


        .ow-feature-box h3 {
            margin: 0 0 14px;
            font-family: "Manrope", sans-serif;
            font-size: 1.6rem;
            line-height: 1.2;
        }


        .ow-feature-box p {
            margin: 0;
            color: rgba(255,255,255,0.73);
        }


        .ow-feature-content h3 {
            margin: 0 0 12px;
            color: var(--ow-green-dark);
            font-family: "Manrope", sans-serif;
            font-size: 1.4rem;
        }


        .ow-feature-content p {
            color: var(--ow-muted);
        }


        /* =====================================================
           CALLOUT
        ====================================================== */

        .ow-callout {
            margin-top: 32px;
            padding: 25px 28px;
            border-left: 4px solid var(--ow-gold);
            border-radius: 0 14px 14px 0;
            background: var(--ow-gold-soft);
        }


        .ow-callout strong {
            display: block;
            margin-bottom: 5px;
            color: var(--ow-green-dark);
        }


        .ow-callout p {
            margin: 0;
            color: var(--ow-muted);
        }


        /* =====================================================
           TRAFFIC / WORK CYCLE
        ====================================================== */

        .ow-cycle {
            display: grid;
            grid-template-columns: repeat(5,minmax(0,1fr));
            gap: 12px;
        }


        .ow-cycle-item {
            position: relative;
            padding: 22px 17px;
            border: 1px solid var(--ow-border);
            border-radius: 15px;
            background: var(--ow-white);
            text-align: center;
        }


        .ow-cycle-item:not(:last-child)::after {
            content: "→";
            position: absolute;
            right: -17px;
            top: 50%;
            z-index: 2;
            transform: translateY(-50%);
            color: var(--ow-gold);
            font-weight: 800;
        }


        .ow-cycle-item .material-icons-round {
            margin-bottom: 10px;
            color: var(--ow-green);
        }


        .ow-cycle-item strong {
            display: block;
            color: var(--ow-green-dark);
            font-size: 0.91rem;
        }


        .ow-cycle-item span {
            display: block;
            margin-top: 5px;
            color: var(--ow-muted);
            font-size: 0.8rem;
        }


        /* =====================================================
           FAQ
        ====================================================== */

        .ow-faq {
            display: grid;
            gap: 12px;
            max-width: 920px;
            margin: 0 auto;
        }


        .ow-faq details {
            border: 1px solid var(--ow-border);
            border-radius: 14px;
            background: var(--ow-white);
            overflow: hidden;
        }


        .ow-faq summary {
            cursor: pointer;
            padding: 21px 23px;
            color: var(--ow-green-dark);
            font-family: "Manrope", sans-serif;
            font-weight: 800;
            list-style: none;
        }


        .ow-faq summary::-webkit-details-marker {
            display: none;
        }


        .ow-faq summary::after {
            content: "+";
            float: right;
            color: var(--ow-gold);
            font-size: 1.3rem;
        }


        .ow-faq details[open] summary::after {
            content: "−";
        }


        .ow-faq-answer {
            padding: 0 23px 22px;
            color: var(--ow-muted);
        }


        .ow-faq-answer p {
            margin: 0;
        }


        /* =====================================================
           LINKS
        ====================================================== */

        .ow-links {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 14px;
        }


        .ow-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 20px;
            border: 1px solid var(--ow-border);
            border-radius: 15px;
            background: var(--ow-white);
            text-decoration: none;
        }


        .ow-link:hover {
            border-color: var(--ow-gold);
        }


        .ow-link strong {
            display: block;
            margin-bottom: 3px;
            color: var(--ow-green-dark);
            font-family: "Manrope", sans-serif;
        }


        .ow-link span {
            color: var(--ow-muted);
            font-size: 0.86rem;
        }


        .ow-link .material-icons-round {
            color: var(--ow-gold);
        }


        /* =====================================================
           FINAL CTA
        ====================================================== */

        .ow-final {
            padding: 85px 0;
            background:
                linear-gradient(
                    135deg,
                    var(--ow-green-dark),
                    var(--ow-green)
                );
            color: var(--ow-white);
            text-align: center;
        }


        .ow-final-inner {
            max-width: 780px;
            margin: 0 auto;
        }


        .ow-final h2 {
            margin: 0 0 16px;
            font-family: "Manrope", sans-serif;
            font-size: clamp(2rem,4vw,3.2rem);
            line-height: 1.1;
        }


        .ow-final p {
            max-width: 680px;
            margin: 0 auto;
            color: rgba(255,255,255,0.75);
        }


        .ow-final .ow-actions {
            justify-content: center;
        }


        /* =====================================================
           DISCLAIMER
        ====================================================== */

        .ow-disclaimer {
            padding: 30px 0;
            background: #f1f3f1;
            color: #68736e;
            font-size: 0.83rem;
        }


        .ow-disclaimer p {
            max-width: 920px;
            margin: 0 auto;
        }


        /* =====================================================
           RESPONSIVE
        ====================================================== */

        @media (max-width: 1000px) {

            .ow-routine {
                grid-template-columns: repeat(2,minmax(0,1fr));
            }

            .ow-cycle {
                grid-template-columns: repeat(3,minmax(0,1fr));
            }

            .ow-cycle-item:not(:last-child)::after {
                display: none;
            }

        }


        @media (max-width: 900px) {

            .ow-hero-inner,
            .ow-feature {
                grid-template-columns: 1fr;
            }

            .ow-grid {
                grid-template-columns: repeat(2,minmax(0,1fr));
            }

        }


        @media (max-width: 640px) {

            .ow-container {
                width: min(100% - 28px, 1180px);
            }

            .ow-hero {
                padding: 65px 0 70px;
            }

            .ow-section {
                padding: 62px 0;
            }

            .ow-answer-card {
                grid-template-columns: 1fr;
                padding: 24px;
            }

            .ow-grid,
            .ow-grid.two,
            .ow-routine,
            .ow-cycle,
            .ow-links {
                grid-template-columns: 1fr;
            }

            .ow-actions {
                flex-direction: column;
            }

            .ow-button {
                width: 100%;
            }

        }

    </style>


