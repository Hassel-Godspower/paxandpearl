# Add these in Vercel -> Project -> Settings -> Environment Variables (server-side only).
# For the import script, put them in your terminal session instead. Never commit real values.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Supabase -> Project Settings -> API -> service_role (SECRET)
PAYSTACK_SECRET_KEY=                  # Paystack -> Settings -> API Keys. sk_test_... first, sk_live_... later (SECRET)
SITE_URL=https://www.your-domain.com  # no trailing slash; used for Paystack/Supabase redirect links and catalog.json

# Already used by the existing site:
# ADMIN_USER=
# ADMIN_PASS=
